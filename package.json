{
  "name": "atest",
  "displayName": "ATest",
  "description": "Генератор тестов с помощью ии",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "atest.openDashboard",
        "title": "ATest: Open dashboard"
      },
      {
        "command": "atest.generateTests",
        "title": "ATest: Generate test"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "atest.generateTests",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "atest.generateTests",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "dotenv": "^18.0.10"
  }
}
